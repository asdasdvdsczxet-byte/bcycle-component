<!DOCTYPE html>
<html lang="ko">
<head>
  <meta charset="UTF-8">
  <title>자전거 커스텀 시뮬레이터</title>
  <style>
    body { font-family: sans-serif; display: flex; gap: 20px; padding: 20px; }
    #canvas-container { border: 1px solid #ccc; background: #f9f9f9; }
    .controls { display: flex; flex-direction: column; gap: 15px; }
    .control-group { display: flex; flex-direction: column; gap: 5px; }
  </style>
</head>
<body>

  <!-- 1. 캔버스 영역 -->
  <div id="canvas-container">
    <canvas id="bikeCanvas" width="800" height="500"></canvas>
  </div>

  <!-- 2. 파츠 선택 컨트롤 영역 -->
  <div class="controls">
    <h2>파츠 선택</h2>
    
    <div class="control-group">
      <label for="frameSelect">프레임 (Frame)</label>
      <select id="frameSelect" onchange="updateBike()">
        <option value="frame_black">블랙 프레임</option>
        <option value="frame_silver">실버 프레임</option>
      </select>
    </div>

    <div class="control-group">
      <label for="wheelSelect">휠셋 (Wheelset)</label>
      <select id="wheelSelect" onchange="updateBike()">
        <option value="wheel_spoke">스포크 휠</option>
        <option value="wheel_carbon">삼발이/카본 휠</option>
      </select>
    </div>

    <div class="control-group">
      <label for="handleSelect">핸들바 (Handlebar)</label>
      <select id="handleSelect" onchange="updateBike()">
        <option value="handle_drop">드롭바</option>
        <option value="handle_riser">라이저바</option>
      </select>
    </div>
  </div>

  <script>
    const canvas = document.getElementById('bikeCanvas');
    const ctx = canvas.getContext('2d');

    // 파츠별 이미지 경로 데이터 매핑
    const partsData = {
      frame: {
        'frame_black': 'images/frame_black.png',
        'frame_silver': 'images/frame_silver.png'
      },
      wheel: {
        'wheel_spoke': 'images/wheel_spoke.png',
        'wheel_carbon': 'images/wheel_carbon.png'
      },
      handle: {
        'handle_drop': 'images/handle_drop.png',
        'handle_riser': 'images/handle_riser.png'
      }
    };

    // 이미지 객체 캐싱
    const imageCache = {};

    function loadImage(src) {
      return new Promise((resolve) => {
        if (imageCache[src]) {
          resolve(imageCache[src]);
          return;
        }
        const img = new Image();
        img.src = src;
        img.onload = () => {
          imageCache[src] = img;
          resolve(img);
        };
      });
    }

    // 캔버스 다시 그리기 (레이어 순서가 매우 중요)
    async function updateBike() {
      // 1. 캔버스 초기화
      ctx.clearRect(0, 0, canvas.width, canvas.height);

      // 2. 현재 선택된 옵션 값 가져오기
      const selectedFrame = document.getElementById('frameSelect').value;
      const selectedWheel = document.getElementById('wheelSelect').value;
      const selectedHandle = document.getElementById('handleSelect').value;

      // 3. 레이어 순서대로 이미지 로드 (뒤 -> 앞)
      // 순서: 휠셋 -> 프레임 -> 핸들바
      const wheelImg = await loadImage(partsData.wheel[selectedWheel]);
      const frameImg = await loadImage(partsData.frame[selectedFrame]);
      const handleImg = await loadImage(partsData.handle[selectedHandle]);

      // 4. 캔버스에 차례대로 렌더링 (800x500 캔버스에 맞춰 정렬)
      ctx.drawImage(wheelImg, 0, 0, canvas.width, canvas.height);
      ctx.drawImage(frameImg, 0, 0, canvas.width, canvas.height);
      ctx.drawImage(handleImg, 0, 0, canvas.width, canvas.height);
    }

    // 페이지 로드 시 첫 렌더링
    window.onload = () => {
      updateBike();
    };
  </script>

</body>
</html>
